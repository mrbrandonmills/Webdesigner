# Amazon Product Advertising API Credentials
# Get these from: https://webservices.amazon.com/paapi5/documentation/
# See AMAZON_PA_API_SETUP_GUIDE.md for complete setup instructions

AMAZON_PA_API_ACCESS_KEY=your_access_key_here
AMAZON_PA_API_SECRET_KEY=your_secret_key_here
AMAZON_PA_API_PARTNER_TAG=brandonmills.com-20
AMAZON_PA_API_REGION=us-east-1

# Copy this file to .env.local and fill in your actual credentials
# Never commit .env.local to Git!
